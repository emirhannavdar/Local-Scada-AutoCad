# Domain, paths and valid certificates must be set before enabling.
server {
    listen 443 ssl;
    server_name scada.example.com;
    ssl_certificate /etc/letsencrypt/live/scada.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/scada.example.com/privkey.pem;
    root /opt/scadawatt/scadawatt-ui;
    index index.html;
    client_max_body_size 8m;
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Authorization $http_authorization;
        proxy_read_timeout 60s;
        proxy_cache off;
    }
    location ~ ^/(docs|redoc|openapi\.json) {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Authorization $http_authorization;
    }
    location / { try_files $uri $uri/ /index.html; }
}
server { listen 80; server_name scada.example.com; return 301 https://$host$request_uri; }
